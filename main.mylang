# MUSHGAME: THE LAST LITTLE SUN
# Entire game written in Tay's Sensible Lang, rendered with Pygame.
import pygame
import math
import random
import json
import sys
import array
import os
from pathlib import Path

W = 1280
H = 800
SAVE = Path(os.environ["MUSHGAME_SAVE_DIR"]) / "mushgame-save.json" if os.environ.get("MUSHGAME_SAVE_DIR") else Path(__file__).with_name("mushgame-save.json")
VERSION = 2
CREAM = (245, 231, 190)
INK = (26, 40, 43)
MINT = (144, 216, 164)
GOLD = (248, 194, 102)
PINK = (235, 135, 157)
TEAL = (84, 169, 156)

